---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';

import HeroV3 from '../sections/home/HeroV3.astro';
import PhilosophyV3 from '../sections/home/PhilosophyV3.astro';
import ProtocolsV3 from '../sections/home/ProtocolsV3.astro';
import ResultsCarousel from '../sections/ResultsCarousel.astro';
import ClinicV3 from '../sections/home/ClinicV3.astro';
import CtaV3 from '../sections/home/CtaV3.astro';

const title = 'Face Doctor Perdizes - Estética Facial Avançada em São Paulo';
const description =
  'Unidade Face Doctor em Perdizes/SP. Ultraformer MPT, bioestimuladores e toxina botulínica com equipe especializada. Agende sua avaliação inicial.';

const homeResults = [
  {
    src: '/results/ultraformer-1.jpg',
    alt: 'Antes e depois de Ultraformer MPT - firmeza e contorno facial',
    procedure: 'Ultraformer MPT',
    caption: 'Lifting microfocado: firmeza e contorno recuperados sem cirurgia.',
    layout: 'horizontal' as const,
  },
  {
    src: '/results/botox-1.jpg',
    alt: 'Antes e depois de toxina botulínica - linhas de expressão suavizadas',
    procedure: 'Toxina Botulínica',
    caption: 'Suavização dinâmica das linhas de expressão, preservando o movimento natural.',
    layout: 'vertical' as const,
  },
  {
    src: '/results/bioestimulador-1.jpg',
    alt: 'Antes e depois de bioestimulador - densidade e firmeza facial',
    procedure: 'Bioestimulador',
    caption: 'Colágeno reativado: densidade e qualidade de pele que nascem de dentro.',
    layout: 'horizontal' as const,
  },
];
---

<BaseLayout title={title} description={description}>
  <SiteHeader slot="header" active="home" />

  <HeroV3 />
  <PhilosophyV3 />
  <ProtocolsV3 />
  <ResultsCarousel
    headline="Resultados que falam por si."
    eyebrow="04 - Antes & Depois"
    items={homeResults}
    variant="light"
  />
  <ClinicV3 />
  <CtaV3 />

  <SiteFooter slot="footer" />
  <WhatsappFloat slot="floats" />
</BaseLayout>
